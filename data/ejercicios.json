  {"bloqueId":"numeros-reales","items":[{"id":"real-1","nivel":1,"tema":"Clasificación","enunciado":"Clasifica \\(\\sqrt{9}\\), \\(\\frac{2}{7}\\) y \\(\\sqrt{3}\\) como racionales o irracionales.","solucion":"\\(\\sqrt{9}=3\\) y \\(\\frac{2}{7}\\) son racionales; \\(\\sqrt{3}\\) es irracional."},{"id":"real-2","nivel":1,"tema":"Valor absoluto","enunciado":"Calcula: \\(|-7{,}5|\\) y \\(|3-8|\\).","solucion":"\\(|-7{,}5|=7{,}5\\) y \\(|3-8|=|-5|=5\\)."},{"id":"real-3","nivel":2,"tema":"Intervalos","enunciado":"Escribe en forma de intervalo: \\(x\\) es mayor o igual que \\(-1\\) y menor que \\(4\\).","solucion":"\\([-1,4)\\)."},{"id":"real-4","nivel":3,"tema":"Aproximaciones","enunciado":"Ordena de menor a mayor: \\(2{,}1\\), \\(\\sqrt{5}\\), \\(\\frac{9}{4}\\).","solucion":"\\(\\sqrt{5}\\approx2{,}236\\) y \\(\\frac{9}{4}=2{,}25\\); queda \\(2{,}1<\\sqrt{5}<\\frac{9}{4}\\)."}],"autoevaluacion":[{"pregunta":"¿Cuál es irracional?","opciones":["\\(0{,}25\\)","\\(\\sqrt{2}\\)","\\(-7\\)"],"correcta":1,"tema":"Clasificación","recomendacion":"clasificacion"},{"pregunta":"¿Cuál es mayor?","opciones":["\\(\\sqrt{5}\\)","\\(2\\)","Son iguales"],"correcta":0,"tema":"Orden","recomendacion":"recta-real"}]},
  {"bloqueId":"potencias-raices","items":[{"id":"pot-1","nivel":1,"tema":"Potencias","enunciado":"Simplifica: \\(3^4 \\div 3^2\\).","solucion":"\\(3^{4-2}=3^2=9\\)."},{"id":"pot-2","nivel":1,"tema":"Raíces exactas","enunciado":"Calcula: \\(\\sqrt{144}\\) y \\(\\sqrt{0{,}49}\\).","solucion":"\\(\\sqrt{144}=12\\) y \\(\\sqrt{0{,}49}=0{,}7\\)."},{"id":"pot-3","nivel":2,"tema":"Suma y resta de radicales","enunciado":"Simplifica y calcula: \\(3\\sqrt{5}-\\sqrt{5}+2\\sqrt{5}\\).","solucion":"Son radicales semejantes: \\((3-1+2)\\sqrt{5}=4\\sqrt{5}\\)."},{"id":"pot-4","nivel":2,"tema":"Producto y cociente de radicales","enunciado":"Calcula: \\(\\sqrt{6}\\cdot\\sqrt{24}\\) y \\(\\frac{\\sqrt{50}}{\\sqrt{2}}\\).","solucion":"\\(\\sqrt{6}\\cdot\\sqrt{24}=\\sqrt{144}=12\\) y \\(\\frac{\\sqrt{50}}{\\sqrt{2}}=\\sqrt{25}=5\\)."},{"id":"pot-5","nivel":2,"tema":"Notación científica","enunciado":"Escribe \\(0{,}000045\\) en notación científica.","solucion":"\\(4{,}5\\cdot10^{-5}\\)."},{"id":"pot-6","nivel":3,"tema":"Operaciones combinadas","enunciado":"Calcula: \\(2^3\\cdot\\sqrt{81}-5^2\\).","solucion":"\\(2^3\\cdot\\sqrt{81}-5^2=8\\cdot9-25=47\\)."}],"autoevaluacion":[{"pregunta":"¿Cuánto vale \\(2^3\\cdot2^4\\)?","opciones":["\\(2^7\\)","\\(4^7\\)","\\(2^{12}\\)"],"correcta":0,"tema":"Potencias","recomendacion":"propiedades-potencias"},{"pregunta":"¿Cuál es la raíz de \\(81\\)?","opciones":["\\(8\\)","\\(9\\)","\\(9\\) y \\(-9\\)"],"correcta":1,"tema":"Raíces","recomendacion":"raices"}]},
  {"bloqueId":"proporcionalidad","items":[{"id":"prop-1","nivel":1,"tema":"Proporcionalidad directa","enunciado":"Si \\(4\\) cuadernos cuestan \\(10\\) euros, ¿cuánto cuestan \\(7\\) al mismo precio?","solucion":"Cada cuaderno cuesta \\(2{,}5\\) euros; \\(7\\) cuestan \\(17{,}5\\) euros."},{"id":"prop-2","nivel":1,"tema":"Proporcionalidad inversa","enunciado":"Si \\(6\\) obreros tardan \\(15\\) días, ¿cuántos días tardan \\(10\\) obreros al mismo ritmo?","solucion":"\\(6\\cdot15=10\\cdot d\\), por tanto \\(d=9\\) días."},{"id":"prop-3","nivel":2,"tema":"Porcentajes","enunciado":"Aplica un descuento del \\(15\\%\\) a \\(80\\) euros.","solucion":"\\(80\\cdot0{,}85=68\\) euros."},{"id":"prop-4","nivel":3,"tema":"Porcentajes sucesivos","enunciado":"Una bicicleta de \\(240\\) euros sube un \\(10\\%\\) y después tiene un descuento del \\(20\\%\\). ¿Precio final?","solucion":"\\(240\\cdot1{,}10\\cdot0{,}80=211{,}20\\) euros."}],"autoevaluacion":[{"pregunta":"En una relación inversa, al duplicar una magnitud la otra...","opciones":["Se duplica","Se reduce a la mitad","No cambia"],"correcta":1,"tema":"Proporcionalidad","recomendacion":"directa-inversa"},{"pregunta":"¿Qué factor aplica un aumento del \\(20\\%\\)?","opciones":["\\(0{,}8\\)","\\(1{,}2\\)","\\(20\\)"],"correcta":1,"tema":"Porcentajes","recomendacion":"porcentajes"}]},
  {"bloqueId":"sucesiones","items":[{"id":"suc-1","nivel":1,"tema":"Patrones","enunciado":"Completa: \\(5,9,13,17,\\ldots\\)","solucion":"Se suma \\(4\\); el siguiente término es \\(21\\)."},{"id":"suc-2","nivel":1,"tema":"Patrones","enunciado":"Completa: \\(81,27,9,3,\\ldots\\)","solucion":"Se divide entre \\(3\\); el siguiente término es \\(1\\)."},{"id":"suc-3","nivel":2,"tema":"Progresiones aritméticas","enunciado":"Una progresión tiene \\(a_1=2\\) y diferencia \\(5\\). Calcula \\(a_8\\).","solucion":"\\(a_8=2+(8-1)\\cdot5=37\\)."},{"id":"suc-4","nivel":3,"tema":"Progresiones geométricas","enunciado":"Una progresión geométrica tiene \\(a_1=3\\) y razón \\(2\\). Calcula \\(a_6\\).","solucion":"\\(a_6=3\\cdot2^{6-1}=3\\cdot32=96\\)."}],"autoevaluacion":[{"pregunta":"¿Cuál es la diferencia en \\(10,7,4,1\\)?","opciones":["\\(3\\)","\\(-3\\)","\\(-2\\)"],"correcta":1,"tema":"Aritméticas","recomendacion":"aritmeticas"},{"pregunta":"¿Qué razón tiene \\(2,6,18\\)?","opciones":["\\(2\\)","\\(3\\)","\\(6\\)"],"correcta":1,"tema":"Geométricas","recomendacion":"geometricas"}]},
  {"bloqueId":"expresiones-algebraicas","items":[{"id":"alg-1","nivel":1,"tema":"Polinomios","enunciado":"Suma: \\((2x+3)+(x-5)\\).","solucion":"\\(3x-2\\)."},{"id":"alg-2","nivel":1,"tema":"Polinomios","enunciado":"Multiplica: \\(3x(2x-5)\\).","solucion":"\\(6x^2-15x\\)."},{"id":"alg-3","nivel":2,"tema":"Productos notables","enunciado":"Desarrolla: \\((x-4)^2\\).","solucion":"\\(x^2-8x+16\\)."},{"id":"alg-4","nivel":3,"tema":"Factor común","enunciado":"Factoriza: \\(12x^3-18x^2+6x\\).","solucion":"El factor común es \\(6x\\): \\(6x(2x^2-3x+1)\\)."}],"autoevaluacion":[{"pregunta":"¿Cuánto es \\(3x+2x\\)?","opciones":["\\(5x\\)","\\(5x^2\\)","\\(6x\\)"],"correcta":0,"tema":"Polinomios","recomendacion":"polinomios"},{"pregunta":"¿Cuál es \\((a+b)^2\\)?","opciones":["\\(a^2+b^2\\)","\\(a^2+2ab+b^2\\)","\\(a^2-ab+b^2\\)"],"correcta":1,"tema":"Productos notables","recomendacion":"notables"}]},
  {"bloqueId":"ecuaciones-sistemas","items":[{"id":"ec-1","nivel":1,"tema":"Primer grado","enunciado":"Resuelve: \\(4x-7=13\\).","solucion":"\\(4x=20\\), luego \\(x=5\\)."},{"id":"ec-2","nivel":1,"tema":"Primer grado","enunciado":"Resuelve: \\(3(x-2)+5=2x+4\\).","solucion":"\\(3x-6+5=2x+4\\), \\(3x-1=2x+4\\), luego \\(x=5\\)."},{"id":"ec-3","nivel":2,"tema":"Segundo grado","enunciado":"Resuelve: \\(x^2-7x+12=0\\).","solucion":"\\((x-3)(x-4)=0\\); las soluciones son \\(x=3\\) y \\(x=4\\)."},{"id":"ec-4","nivel":3,"tema":"Sistemas","enunciado":"En un cine se venden \\(15\\) entradas entre adulto (\\(8\\) euros) y joven (\\(5\\) euros), por \\(96\\) euros. ¿Cuántas de cada tipo?","solucion":"\\(a+j=15\\), \\(8a+5j=96\\). Sustituyendo \\(j=15-a\\): \\(8a+75-5a=96\\); \\(a=7\\) y \\(j=8\\)."}],"autoevaluacion":[{"pregunta":"Solución de \\(2x+6=14\\)","opciones":["\\(2\\)","\\(4\\)","\\(10\\)"],"correcta":1,"tema":"Primer grado","recomendacion":"primer-grado"},{"pregunta":"¿Cuántas soluciones puede tener una ecuación de segundo grado?","opciones":["Hasta dos","Siempre una","Siempre tres"],"correcta":0,"tema":"Segundo grado","recomendacion":"segundo-grado"}]},
  {"bloqueId":"funciones","items":[{"id":"fun-1","nivel":1,"tema":"Valores de una función","enunciado":"Si \\(y=3x-2\\), calcula \\(y\\) para \\(x=4\\).","solucion":"\\(y=3\\cdot4-2=10\\)."},{"id":"fun-2","nivel":1,"tema":"Pendiente","enunciado":"Indica la pendiente y la ordenada en el origen de \\(y=-2x+5\\).","solucion":"La pendiente es \\(-2\\) y la ordenada en el origen es \\(5\\)."},{"id":"fun-3","nivel":2,"tema":"Representación","enunciado":"Da tres puntos de la recta \\(y=2x+1\\).","solucion":"Por ejemplo, \\((0,1)\\), \\((1,3)\\) y \\((2,5)\\)."},{"id":"fun-4","nivel":3,"tema":"Modelización","enunciado":"Un taxi cobra \\(3\\) euros de bajada de bandera y \\(1{,}20\\) euros por km. Escribe la función del coste y calcula el coste de \\(8\\) km.","solucion":"\\(C(x)=1{,}20x+3\\). Para \\(8\\) km: \\(C(8)=1{,}20\\cdot8+3=12{,}60\\) euros."}],"autoevaluacion":[{"pregunta":"En \\(y=mx+n\\), ¿qué representa \\(m\\)?","opciones":["La pendiente","El corte con \\(y\\)","La variable"],"correcta":0,"tema":"Funciones lineales","recomendacion":"lineales"},{"pregunta":"¿Qué ocurre si la pendiente es positiva?","opciones":["La recta crece","La recta decrece","La recta es vertical"],"correcta":0,"tema":"Gráficas","recomendacion":"interpretacion"}]},
  {"bloqueId":"geometria","items":[{"id":"geo-1","nivel":1,"tema":"Pitágoras","enunciado":"Calcula la hipotenusa con catetos \\(5\\) y \\(12\\).","solucion":"\\(\\sqrt{5^2+12^2}=13\\)."},{"id":"geo-2","nivel":1,"tema":"Áreas","enunciado":"Calcula el área de un triángulo de base \\(9\\) cm y altura \\(6\\) cm.","solucion":"\\(A=\\frac{9\\cdot6}{2}=27\\text{ cm}^2\\)."},{"id":"geo-3","nivel":2,"tema":"Volumen","enunciado":"Calcula el volumen de un prisma de área de base \\(12\\text{ cm}^2\\) y altura \\(8\\text{ cm}\\).","solucion":"\\(V=12\\cdot8=96\\text{ cm}^3\\)."},{"id":"geo-4","nivel":3,"tema":"Semejanza","enunciado":"Dos triángulos semejantes tienen razón \\(\\frac{3}{2}\\). Si un lado del menor mide \\(8\\) cm, ¿cuánto mide el correspondiente del mayor?","solucion":"\\(8\\cdot\\frac{3}{2}=12\\text{ cm}\\)."}],"autoevaluacion":[{"pregunta":"En Pitágoras, la hipotenusa es...","opciones":["El lado mayor","Cualquier cateto","El ángulo recto"],"correcta":0,"tema":"Pitágoras","recomendacion":"pitagoras"},{"pregunta":"El volumen de un prisma es...","opciones":["Base \\(\\cdot\\) altura","Perímetro \\(\\cdot\\) altura","Base + altura"],"correcta":0,"tema":"Volúmenes","recomendacion":"volumen"}]},
  {"bloqueId":"estadistica-probabilidad","items":[{"id":"est-1","nivel":1,"tema":"Media","enunciado":"Calcula la media de \\(4,5,6\\) y \\(9\\).","solucion":"\\(\\frac{4+5+6+9}{4}=6\\)."},{"id":"est-2","nivel":1,"tema":"Mediana y moda","enunciado":"Halla la mediana y la moda de \\(3,5,5,6,8,10\\).","solucion":"La mediana es \\(\\frac{5+6}{2}=5{,}5\\) y la moda es \\(5\\)."},{"id":"est-3","nivel":2,"tema":"Frecuencia relativa","enunciado":"En una clase de \\(30\\) alumnos, \\(12\\) van andando al instituto. Calcula la frecuencia relativa y el porcentaje.","solucion":"\\(\\frac{12}{30}=0{,}4=40\\%\\)."},{"id":"est-4","nivel":3,"tema":"Probabilidad","enunciado":"Se lanzan dos dados. ¿Cuál es la probabilidad de que la suma sea \\(7\\)?","solucion":"Hay \\(6\\) casos favorables de \\(36\\) posibles: \\(\\frac{6}{36}=\\frac{1}{6}\\)."}],"autoevaluacion":[{"pregunta":"La mediana es...","opciones":["El dato central ordenado","El más frecuente","La suma de datos"],"correcta":0,"tema":"Estadística","recomendacion":"dispersion"},{"pregunta":"¿Cuál es la probabilidad de cara en una moneda equilibrada?","opciones":["\\(0\\)","\\(\\frac{1}{2}\\)","\\(1\\)"],"correcta":1,"tema":"Probabilidad","recomendacion":"probabilidad"}]}
